+    void RSP::drawLine(uint32_t a, uint32_t b, float width) {
+        // Line microcode (Fast3D line build, L3DEX): the RSP draws a screen-space quad of the given width
+        // between the two loaded vertices. Done here with four copies of the vertices whose clip-space
+        // positions are moved perpendicular to the line on screen, then mapped back to object space.
+        const uint32_t First = RSP_MAX_VERTICES - 4;
+        if ((a >= First) || (b >= First) || (a == b)) {
+            return;
+        }
+
+        vertices[First + 0] = vertices[a];
+        vertices[First + 1] = vertices[a];
+        vertices[First + 2] = vertices[b];
+        vertices[First + 3] = vertices[b];
+        setVertexCommon<true, sizeof(Vertex)>(0, First, First + 4);
+
+        const int workloadCursor = state->ext.workloadQueue->writeCursor;
+        Workload &workload = state->ext.workloadQueue->workloads[workloadCursor];
+        auto &posFloats = workload.drawData.posFloats;
+        auto &posTransformed = workload.drawData.posTransformed;
+        auto &posScreen = workload.drawData.posScreen;
+        const interop::RSPViewport &viewport = viewportStack[viewportStackSize - 1];
+        float clip[2][4], screen[2][3], scale[3];
+        hlslpp::store(posTransformed[indices[First + 0]], clip[0]);
+        hlslpp::store(posTransformed[indices[First + 2]], clip[1]);
+        hlslpp::store(posScreen[indices[First + 0]], screen[0]);
+        hlslpp::store(posScreen[indices[First + 2]], screen[1]);
+        hlslpp::store(viewport.scale, scale);
+        if ((clip[0][3] <= 0.0f) || (clip[1][3] <= 0.0f) || (scale[0] == 0.0f) || (scale[1] == 0.0f)) {
+            return;
+        }
+
+        const float dx = screen[1][0] - screen[0][0];
+        const float dy = screen[1][1] - screen[0][1];
+        const float length = sqrtf(dx * dx + dy * dy);
+        if (length < 1e-6f) {
+            return;
+        }
+
+        const float nx = -dy / length * width * 0.5f;
+        const float ny = dx / length * width * 0.5f;
+        const hlslpp::float4x4 invMvp = hlslpp::inverse(modelViewProjMatrix);
+        for (uint32_t i = 0; i < 4; i++) {
+            const float *c = clip[i / 2];
+            const float side = (i & 1) ? -1.0f : 1.0f;
+            const hlslpp::float4 movedClip(c[0] + side * nx * c[3] / scale[0], c[1] - side * ny * c[3] / scale[1], c[2], c[3]);
+            const hlslpp::float4 objPos = hlslpp::mul(movedClip, invMvp);
+            float obj[4];
+            hlslpp::store(objPos, obj);
+            if (obj[3] == 0.0f) {
+                return;
+            }
+
+            const uint32_t globalIndex = indices[First + i];
+            posFloats[globalIndex * 3 + 0] = obj[0] / obj[3];
+            posFloats[globalIndex * 3 + 1] = obj[1] / obj[3];
+            posFloats[globalIndex * 3 + 2] = obj[2] / obj[3];
+            posTransformed[globalIndex] = movedClip;
+            posScreen[globalIndex] = (movedClip.xyz / hlslpp::float3(movedClip.w, -movedClip.w, movedClip.w)) * viewport.scale + viewport.translate;
+        }
+
+        // The quad's winding depends on the line's direction: draw it with culling off.
+        const uint32_t cullBits = geometryModeStack[geometryModeStackSize - 1] & cullBothMask;
+        if (cullBits != 0) {
+            clearGeometryMode(cullBits);
+        }
+
+        drawIndexedTri(First + 0, First + 1, First + 3);
+        drawIndexedTri(First + 0, First + 3, First + 2);
+        if (cullBits != 0) {
+            setGeometryMode(cullBits);
+        }
+    }
