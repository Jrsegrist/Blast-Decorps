diff --git a/src/gbi/rt64_gbi_l3d.cpp b/src/gbi/rt64_gbi_l3d.cpp
new file mode 100644
index 0000000..686129f
--- /dev/null
+++ b/src/gbi/rt64_gbi_l3d.cpp
@@ -0,0 +1,26 @@
+//
+// RT64
+//
+
+#include "rt64_gbi_l3d.h"
+
+#include "rt64_gbi_f3d.h"
+
+namespace RT64 {
+    namespace GBI_L3D {
+        // gSPLine3D / gSPLineW3D: w1 = flag << 24 | v0 * 10 << 16 | v1 * 10 << 8 | wd.
+        // The line is 1.5 pixels wide plus half a pixel per unit of wd.
+        void line3D(State *state, DisplayList **dl) {
+            const uint32_t v0 = (*dl)->p1(16, 8) / 10;
+            const uint32_t v1 = (*dl)->p1(8, 8) / 10;
+            const uint32_t wd = (*dl)->p1(0, 8);
+            state->rsp->drawLine(v0, v1, 1.5f + float(wd) * 0.5f);
+        }
+
+        void setup(GBI *gbi) {
+            GBI_F3D::setup(gbi);
+
+            gbi->map[L3D_G_LINE3D] = &line3D;
+        }
+    }
+};
