diff --git a/src/common/rt64_rdram_layout.h b/src/common/rt64_rdram_layout.h
new file mode 100644
index 0000000..f4b527f
--- /dev/null
+++ b/src/common/rt64_rdram_layout.h
@@ -0,0 +1,51 @@
+//
+// RT64
+//
+
+#pragma once
+
+#include <stdint.h>
+
+// How the RDRAM buffer handed to RT64 is laid out.
+//
+// Default (emulator layout): every 32-bit word is stored as a host-endian uint32_t holding the
+// big-endian word, so the N64 byte at address A lives at RDRAM[A ^ 3] and the halfword at RDRAM[A ^ 2].
+//
+// RT64_NATIVE_HOST_LAYOUT (for native ports that run the game's own code on a little-endian host
+// and use their memory as RDRAM directly):
+//  - structures the game builds or reads field by field (Gfx, Mtx, Vtx, Vp, Light, LookAt) have
+//    host-endian fields in their declared order: the halfword at A is at RDRAM[A], a Vtx is
+//    {x, y, z, flag, s, t, r, g, b, a};
+//  - byte streams (textures, palettes, colour and depth images, microcode) are big-endian bytes:
+//    the N64 byte at A is RDRAM[A].
+// 32-bit words (display list commands, Mtx elements, addresses) are host-endian uint32_t in both.
+
+#ifdef RT64_NATIVE_HOST_LAYOUT
+#   define RT64_RDRAM_BYTE_XOR 0
+#   define RT64_RDRAM_HALF_XOR 0
+#else
+#   define RT64_RDRAM_BYTE_XOR 3
+#   define RT64_RDRAM_HALF_XOR 2
+#endif
+
+// Vp_t element indices for the x, y and z components.
+#ifdef RT64_NATIVE_HOST_LAYOUT
+#   define RT64_VP_X 0
+#   define RT64_VP_Y 1
+#   define RT64_VP_Z 2
+#else
+#   define RT64_VP_X 1
+#   define RT64_VP_Y 0
+#   define RT64_VP_Z 3
+#endif
+
+namespace RT64 {
+    // A word of light colour (G_MOVEWORD G_MW_LIGHTCOL: 0xRRGGBBxx) as stored in a Light.
+    inline uint32_t lightColorWord(uint32_t value) {
+#   ifdef RT64_NATIVE_HOST_LAYOUT
+        return ((value >> 24) & 0xFFU) | ((value >> 8) & 0xFF00U) | ((value << 8) & 0xFF0000U) | (value << 24);
+#   else
+        return value;
+#   endif
+    }
+};
