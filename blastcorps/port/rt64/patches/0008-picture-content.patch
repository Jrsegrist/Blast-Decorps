RT64 port patch 0008: what each presented picture shows (Blast Corps port; MIT, as RT64).

The host's frame-time report (src/live/live_rt64.cpp) checks that the content
of the pictures advances evenly: each in-between picture shows the game frame
before plus its interpolation weight of the way to its own frame.  The
workload queue keeps, with the interpolated frame counters the present thread
reads, the workload the pictures were rendered from and each picture's
weight in the order they are presented; PresentedInfo passes them on
(contentWorkload, contentWeight; -1 when unknown).  Nothing else changes.

--- a/src/hle/rt64_present_queue.h
+++ b/src/hle/rt64_present_queue.h
@@ -31,6 +31,10 @@
             uint32_t viOriginalRate = 0;
             uint32_t syncInterval = 0;  // the swap chain present's
             Timestamp readyTime;        // when the picture was drawn (before any pacing wait)
+            // (port patch 0008) what the picture shows: the workload it was rendered from and its
+            // interpolation weight (1: the workload's own frame; -1: unknown)
+            uint64_t contentWorkload = 0;
+            float contentWeight = -1.0f;
         };
 
         // (port patch 0007) How pictures between the game's are scheduled when the vsync pacing (0005)
--- a/src/hle/rt64_present_queue.cpp
+++ b/src/hle/rt64_present_queue.cpp
@@ -476,8 +476,23 @@
                 }
 
                 if (presentedHook != nullptr) {
+                    // (port patch 0008) what the picture shows (one picture of the game's own frame when
+                    // nothing is interpolated)
+                    uint64_t contentWorkload = 0;
+                    float contentWeight = -1.0f;
+                    {
+                        std::scoped_lock<std::mutex> weightLock(ext.sharedResources->interpolatedMutex);
+                        contentWorkload = frameCounters.workloadId;
+                        if ((framesToPresent > 1) && (uint32_t(i) < InterpolatedFrameCounters::MaxWeights)) {
+                            contentWeight = frameCounters.weights[i];
+                        }
+                        else if (framesToPresent == 1) {
+                            contentWeight = (frameCounters.count == 1) ? frameCounters.weights[0] : 1.0f;
+                        }
+                    }
+
                     presentedHook({ present.presentId, uint32_t(i), uint32_t(framesToPresent), hold, present.submitTime, presentTimestamp,
-                        targetRate, viOriginalRate, syncInterval, readyTime });
+                        targetRate, viOriginalRate, syncInterval, readyTime, contentWorkload, contentWeight });
                 }
             }
         }
