+
+// Fast3D line microcode (the 2.0D "L3D" build): F3D with G_LINE3D in place of the quad opcode.
+#define L3D_G_LINE3D 0xB5
+
+namespace RT64 {
+    namespace GBI_L3D {
+        void line3D(State *state, DisplayList **dl);
+
+        void setup(GBI *gbi);
+    };
+};
